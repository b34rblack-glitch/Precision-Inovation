{
  "expo": {
    "name": "Precision Innovation",
    "slug": "precision-innovation",
    "scheme": "precision-innovation",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.precisioninnovation"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A1D21",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.precisioninnovation"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Precision Innovation uses the camera to photograph your targets at the range and keep them with the workup or session they belong to.",
          "photosPermission": "Precision Innovation reads a photo you choose so it can be attached to a workup or range session.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "googleWebClientId": "",
      "googleIosClientId": ""
    }
  }
}
